# Final expert delivery: copy to .env, configure API, run Docker Compose.
# Used by Docker and local quick start. Literal values, no shell commands.
# Auto-detect data/knowledge.json or data/kb.zip; otherwise synthetic demo.
# Docker mounts ./data read-only. Optional external folder (Compose only):
# PSB_DATA_DIR=./data
# PSB_PORT=8080
# Optional host-file override for Docker and local Python (JSON or ZIP):
PSB_CORPUS_FILE=
PSB_LLM_BASE_URL=
PSB_LLM_API_KEY=
PSB_LLM_MODEL=
PSB_LLM_TIMEOUT_SECONDS=35

# API settings for expert web app and separate CSV submissions. Never commit keys.
# Generation and review use the same LLM_MODEL via /chat/completions.
LLM_BASE_URL=
LLM_API_KEY=
# Default from the supplied organizer starter:
LLM_MODEL=
# /embeddings and /rerank use LLM_BASE_URL; separate keys are optional.
# Empty auxiliary key falls back to LLM_API_KEY (or PSB_LLM_API_KEY).
EMBEDDER_API_KEY=
RERANKER_API_KEY=
EMB_MODEL=baai/bge-m3
RERANKER_MODEL=cohere/rerank-5-fast
PSB_USE_EMBEDDINGS=true
PSB_USE_RERANKER=true
# Set both flags to false if auxiliary services are unavailable.
TOP_K=40
RERANKER_TOP_N=12
MAX_WORKERS=2
MAX_TOKENS=3500
