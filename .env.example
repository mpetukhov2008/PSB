# Read by START_PSB.cmd, Python entry points and Docker Compose.
# Use literal values; only full-line comments. Never commit a populated .env.
# Default: clearly labeled synthetic corpus; model disabled.
PSB_CORPUS_FILE=./samples/psb-demo.json
PSB_LLM_BASE_URL=
PSB_LLM_API_KEY=
# Exact DeepSeek V4.1 Flash API model identifier must come from organizers.
PSB_LLM_MODEL=
# Timeout per model call (generation + review use up to two calls).
PSB_LLM_TIMEOUT_SECONDS=35
# Optional override for Python/solution.py; paths are relative to the project.
# PSB_CORPUS_PATH=data/knowledge.json

