# Used automatically by Docker Compose. Never commit a populated .env.
# Default: clearly labeled synthetic corpus; model disabled.
PSB_CORPUS_FILE=./samples/psb-demo.json
PSB_LLM_BASE_URL=
PSB_LLM_API_KEY=
# Exact DeepSeek V4.1 Flash API model identifier must come from organizers.
PSB_LLM_MODEL=
# For Python/solution.py, export this variable in the process environment.
# PSB_CORPUS_PATH=data/knowledge.json
